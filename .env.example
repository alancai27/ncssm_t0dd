# Google OAuth (required for sign-in).
# Create a client at console.cloud.google.com -> APIs & Services -> Credentials,
# and register this exact Authorized redirect URI:
#   http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this email domain may sign in. Enforced server-side against the
# verified email Google returns, not via the `hd` hint.
ALLOWED_EMAIL_DOMAIN=ncssm.edu

# Must exactly match a redirect URI registered on the OAuth client above.
TODD_REDIRECT_URI=http://localhost:8000/auth/callback

# Signs session cookies. Generate with: openssl rand -hex 32
# If unset, a random key is made at boot and sessions drop on restart.
TODD_SECRET_KEY=

# Model backend. See tutor/config.py for the full list.
TUTOR_PROVIDER=openrouter
OPENROUTER_API_KEY=
